{% extends "layouts/app.twig" %}

{% block title %}{{ appName }} · Dashboard builder{% endblock %}

{% block main %}
    <section class="dashboard-page" aria-labelledby="dashboard-title">
        <nav class="breadcrumbs dashboard-breadcrumbs" aria-label="Breadcrumb">
            <a href="/dashboards">Dashboards</a>
            <span class="breadcrumb-separator" aria-hidden="true">/</span>
            <span aria-current="page">Builder preview</span>
        </nav>

        <header class="dashboard-page-header">
            <div class="dashboard-heading-copy">
                <p class="eyebrow">CUSTOM DASHBOARD</p>
                <div class="dashboard-title-row">
                    <h1 id="dashboard-title">Build an overview that fits your work</h1>
                    <span class="preview-pill"><span aria-hidden="true"></span>Preview only</span>
                </div>
                <p class="dashboard-intro">Bring the Morph views your team needs into one clear, configurable workspace.</p>
            </div>
            <div class="dashboard-primary-actions">
                <span class="draft-state"><span aria-hidden="true"></span>Unsaved preview</span>
                <button class="ui-button ui-button-disabled" type="button" disabled aria-describedby="save-dashboard-note">Save dashboard</button>
                <span class="visually-hidden" id="save-dashboard-note">Saving is unavailable until authenticated workspace and dashboard persistence are implemented.</span>
            </div>
        </header>

        <aside class="dashboard-preview-banner" aria-label="Preview limitations">
            <span class="notice-icon" aria-hidden="true">i</span>
            <p><strong>Interactive UI preview.</strong> Add, remove, reorder, and configure block presentation below. Preview choices are encoded as non-sensitive URL options only; nothing is saved, no workspace is selected, and no live records or database queries are loaded.</p>
        </aside>

        <section class="dashboard-toolbar" aria-label="Dashboard preview controls">
            <form method="get" action="/dashboards/preview" class="preview-controls-form">
                {% for value in blockValues %}
                    <input type="hidden" name="blocks[]" value="{{ value }}">
                {% endfor %}
                <div class="preview-control-field">
                    <label for="preview-period">Preview period</label>
                    <select id="preview-period" name="period">
                        {% for option in periodOptions %}
                            <option value="{{ option.value }}"{% if option.selected %} selected{% endif %}>{{ option.label }}</option>
                        {% endfor %}
                    </select>
                </div>
                <div class="preview-control-field">
                    <label for="preview-density">Card spacing</label>
                    <select id="preview-density" name="density">
                        {% for option in densityOptions %}
                            <option value="{{ option.value }}"{% if option.selected %} selected{% endif %}>{{ option.label }}</option>
                        {% endfor %}
                    </select>
                </div>
                <button class="ui-button ui-button-secondary" type="submit">Apply preview settings</button>
            </form>

            <div class="dashboard-toolbar-actions">
                <details class="filter-disclosure">
                    <summary class="ui-button ui-button-secondary">
                        <span aria-hidden="true">＋</span>
                        Filters
                        <span class="filter-count">0</span>
                    </summary>
                    <div class="filter-disclosure-panel">
                        <strong>Filters need a Data Source</strong>
                        <p>Once a workspace Data Source is available, filters can be composed from Fields the current user is allowed to access.</p>
                        <button class="ui-button ui-button-disabled" type="button" disabled>Add filter</button>
                    </div>
                </details>
                {% include "dashboard/_block-picker.twig" %}
            </div>
        </section>

        {% if truncatedBlockInput %}
            <p class="inline-notice" role="status">This preview only displays the first {{ previewBlockLimit }} block selections.</p>
        {% endif %}

        <div class="dashboard-section-heading">
            <div>
                <h2>Dashboard blocks</h2>
                <p>Compose the views that help your team find the right workspace data.</p>
            </div>
            <span class="block-count">{{ blocks|length }} {{ blocks|length == 1 ? 'block' : 'blocks' }}</span>
        </div>

        {% if blocks is empty %}
            <section class="dashboard-empty-state" aria-labelledby="empty-dashboard-title">
                <span class="empty-state-mark" aria-hidden="true">
                    <svg viewBox="0 0 40 40" fill="none">
                        <rect x="5" y="6" width="30" height="28" rx="6" stroke="currentColor" stroke-width="1.7"></rect>
                        <path d="M5 15h30M15 15v19m7-12h7m-7 5h7" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"></path>
                    </svg>
                </span>
                <p class="empty-state-eyebrow">YOUR DASHBOARD, YOUR WAY</p>
                <h3 id="empty-dashboard-title">Start with one useful view</h3>
                <p class="empty-state-copy">Choose any available view from Morph's registered block capabilities. Each block exposes only the settings its trusted definition supports.</p>
                {% include "dashboard/_block-picker.twig" %}
            </section>
        {% else %}
            <section class="dashboard-block-grid{% if density == 'compact' %} is-compact{% endif %}" aria-label="Configured dashboard blocks">
                {% for block in blocks %}
                    <article class="dashboard-block-card" aria-labelledby="block-title-{{ block.index }}">
                        <header class="dashboard-block-header">
                            <div class="dashboard-block-heading">
                                <span class="block-category">{{ block.category }}</span>
                                <h3 id="block-title-{{ block.index }}">{{ block.label }}</h3>
                                <p>{{ block.description }}</p>
                            </div>
                            <details class="block-actions">
                                <summary class="block-actions-trigger" aria-label="Actions for {{ block.label }} block"><span aria-hidden="true">&hellip;</span></summary>
                                <div class="block-actions-menu">
                                    {% if block.moveUpValues is not null %}
                                        <form method="get" action="/dashboards/preview">
                                            <input type="hidden" name="period" value="{{ period }}">
                                            <input type="hidden" name="density" value="{{ density }}">
                                            {% for value in block.moveUpValues %}<input type="hidden" name="blocks[]" value="{{ value }}">{% endfor %}
                                            <button type="submit">Move up</button>
                                        </form>
                                    {% endif %}
                                    {% if block.moveDownValues is not null %}
                                        <form method="get" action="/dashboards/preview">
                                            <input type="hidden" name="period" value="{{ period }}">
                                            <input type="hidden" name="density" value="{{ density }}">
                                            {% for value in block.moveDownValues %}<input type="hidden" name="blocks[]" value="{{ value }}">{% endfor %}
                                            <button type="submit">Move down</button>
                                        </form>
                                    {% endif %}
                                    <form method="get" action="/dashboards/preview">
                                        <input type="hidden" name="period" value="{{ period }}">
                                        <input type="hidden" name="density" value="{{ density }}">
                                        {% for value in block.removeValues %}<input type="hidden" name="blocks[]" value="{{ value }}">{% endfor %}
                                        <button class="is-destructive" type="submit">Remove from preview</button>
                                    </form>
                                </div>
                            </details>
                        </header>

                        <div class="block-preview-area block-preview-{{ block.id }}">
                            <span class="block-preview-icon block-preview-glyph" aria-hidden="true">{{ block.category|slice(0, 1) }}</span>
                            <span class="block-presentation-label">{{ block.presentationLabel }}</span>
                            <strong>Connect a Data Source to configure this block</strong>
                            <p>No values or records are shown. Choose an authorized Data Source and Fields when the Database Builder is available.</p>
                        </div>

                        <details class="block-settings">
                            <summary>
                                <span>Block settings</span>
                                <span class="settings-needed">Data Source needed</span>
                            </summary>
                            <div class="block-settings-content">
                                <p class="settings-explainer">The available options are described by the block capability. Protected source and Field choices will be loaded and validated server-side in the implemented product.</p>

                                <form method="get" action="/dashboards/preview" class="presentation-form">
                                    <input type="hidden" name="period" value="{{ period }}">
                                    <input type="hidden" name="density" value="{{ density }}">
                                    {% for value in blockValues %}
                                        {% if loop.index0 < block.index %}<input type="hidden" name="blocks[]" value="{{ value }}">{% endif %}
                                    {% endfor %}
                                    <div class="preview-control-field">
                                        <label for="block-presentation-{{ block.index }}">Display style</label>
                                        <select id="block-presentation-{{ block.index }}" name="blocks[]">
                                            {% for option in block.presentations %}
                                                <option value="{{ option.value }}"{% if option.selected %} selected{% endif %}>{{ option.label }}</option>
                                            {% endfor %}
                                        </select>
                                    </div>
                                    {% for value in blockValues %}
                                        {% if loop.index0 > block.index %}<input type="hidden" name="blocks[]" value="{{ value }}">{% endif %}
                                    {% endfor %}
                                    <button class="ui-button ui-button-secondary" type="submit">Apply to preview</button>
                                </form>

                                <dl class="block-setting-list">
                                    {% for setting in block.settings %}
                                        <div>
                                            <dt>{{ setting.label }}</dt>
                                            <dd>{{ setting.description }}<span class="pending-setting">Available with workspace data</span></dd>
                                        </div>
                                    {% endfor %}
                                </dl>
                            </div>
                        </details>
                    </article>
                {% endfor %}
            </section>
        {% endif %}
    </section>
{% endblock %}
