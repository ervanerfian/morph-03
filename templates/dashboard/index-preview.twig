{% extends "layouts/app.twig" %}

{% block title %}{{ appName }} · Dashboards{% endblock %}

{% block main %}
    <section class="dashboard-page" aria-labelledby="dashboard-title">
        <nav class="breadcrumbs dashboard-breadcrumbs" aria-label="Breadcrumb">
            <a href="/">Home</a>
            <span class="breadcrumb-separator" aria-hidden="true">/</span>
            <span aria-current="page">Dashboards</span>
        </nav>

        <header class="dashboard-page-header">
            <div class="dashboard-heading-copy">
                <p class="eyebrow">WORKSPACE VIEWS</p>
                <div class="dashboard-title-row">
                    <h1 id="dashboard-title">Dashboards</h1>
                    <span class="preview-pill"><span aria-hidden="true"></span>Preview only</span>
                </div>
                <p class="dashboard-intro">Bring the Morph views your team checks most often into one configurable place.</p>
            </div>
            <div class="dashboard-primary-actions">
                <a class="ui-button ui-button-primary" href="/dashboards/preview">Open builder preview</a>
            </div>
        </header>

        <aside class="dashboard-preview-banner" aria-label="Preview limitations">
            <span class="notice-icon" aria-hidden="true">i</span>
            <p><strong>No saved dashboards yet.</strong> This catalog is a non-authenticated preview. The builder link opens an interactive draft, but no dashboard is created or stored.</p>
        </aside>

        <section class="dashboard-empty-state" aria-labelledby="empty-dashboard-title">
            <span class="empty-state-mark" aria-hidden="true">
                <svg viewBox="0 0 40 40" fill="none">
                    <rect x="5" y="6" width="30" height="28" rx="6" stroke="currentColor" stroke-width="1.7"></rect>
                    <path d="M5 15h30M15 15v19m7-12h7m-7 5h7" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"></path>
                </svg>
            </span>
            <p class="empty-state-eyebrow">A CLEAR STARTING POINT</p>
            <h3 id="empty-dashboard-title">Your workspace dashboards will live here</h3>
            <p class="empty-state-copy">When Identity, Workspace, Data Sources, and dashboard persistence are implemented, this page will list the dashboards available to your authorized workspace. For now, explore the Morph-owned builder preview.</p>
            <a class="ui-button ui-button-primary" href="/dashboards/preview">Try the builder preview</a>
        </section>
    </section>
{% endblock %}
