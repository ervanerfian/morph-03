</div>
<div class="card-body">
<div dir="ltr">
<div class="mt-3" style="height: 300px">
<canvas id="draw-time-chart"></canvas>
</div>
</div>
</div>
<!-- end card body-->
</div>
<!-- end card -->
</div>
</div>
</main>

            {{ include('partials/footer.html.twig') }}
        </div>
<!-- End Page content -->
</div>

    {{ include('partials/customizer.html.twig') }}

    {{ include('partials/footer-scripts.html.twig') }}

