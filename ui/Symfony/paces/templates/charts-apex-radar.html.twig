{% extends 'layouts/base.html.twig' %}



{% set title = 'Radar Apexchart' %}

{% block styles %}

{% endblock %}

{% block content %}
<div class="wrapper">
        {{ include('partials/topbar.html.twig', {"subtitle": "Charts", "title": "Radar Apexchart"}) }}

        {{ include('partials/sidenav.html.twig') }}

        <!-- Start Page Content here -->
<div class="page-content">
<main>

                {{ include('partials/page-title.html.twig', {"subtitle": "Charts", "title": "Radar Apexchart"}) }}

                <div class="container-fluid">
<div class="grid grid-cols-1 xl:grid-cols-2 gap-base">
<div class="card">
<div class="card-header">
<h4 class="card-title">Basic Radar Chart</h4>
</div>
<div class="card-body">
<div dir="ltr">
<div class="apex-charts" id="basic-radar"></div>
</div>
</div>
<!-- end card body-->
</div>
<!-- end card -->
<div class="card">
<div class="card-header">
<h4 class="card-title">Radar with Polygon-fill</h4>
</div>
<div class="card-body">
<div dir="ltr">
<div class="apex-charts" id="radar-polygon"></div>
</div>
</div>
<!-- end card body-->
</div>
<!-- end card -->
<div class="card">
<div class="card-header">
<h4 class="card-title">Radar – Multiple Series</h4>
</div>
<div class="card-body">
<div dir="ltr">
<div class="apex-charts" id="radar-multiple-series"></div>
<div class="mt-2 text-center">
<button class="btn btn-sm bg-primary text-white hover:bg-primary-hover" id="update-radar">Update</button>
</div>
</div>
</div>
<!-- end card body-->
</div>
<!-- end card -->
</div>
</div>
</main>

            {{ include('partials/footer.html.twig') }}
        </div>
<!-- End Page content -->
</div>

    {{ include('partials/customizer.html.twig') }}

    {{ include('partials/footer-scripts.html.twig') }}

    <!-- Apex Chart js -->

<!-- Apex Chart Polar Area Demo js -->
{% endblock %}

{% block scripts %}
<script src="/plugins/apexcharts/apexcharts.min.js"></script>
    <script src="/js/pages/chart-apex-radar.js"></script>
{% endblock %}
