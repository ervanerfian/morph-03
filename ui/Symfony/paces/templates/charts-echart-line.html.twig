{% extends 'layouts/base.html.twig' %}



{% set title = 'Line Echart' %}

{% block styles %}

{% endblock %}

{% block content %}
<div class="wrapper">
        {{ include('partials/topbar.html.twig', {"subtitle": "Charts", "title": "Line Echart"}) }}

        {{ include('partials/sidenav.html.twig') }}

        <!-- Start Page Content here -->
<div class="page-content">
<main>

                {{ include('partials/page-title.html.twig', {"subtitle": "Charts", "title": "Line Echart"}) }}

                <div class="container-fluid">
<div class="grid grid-cols-1 xl:grid-cols-2 gap-base">
<div class="card">
<div class="card-header">
<h4 class="card-title">Line Chart</h4>
</div>
<div class="card-body">
<div id="chart-line" style="min-height: 300px"></div>
</div>
</div>
<!-- end card -->
<div class="card">
<div class="card-header">
<h4 class="card-title">Line Stacked Chart</h4>
</div>
<div class="card-body">
<div id="chart-line-stacked" style="min-height: 300px"></div>
</div>
</div>
<!-- end card -->
<div class="card">
<div class="card-header">
<h4 class="card-title">Line Marker</h4>
</div>
<div class="card-body">
<div id="chart-line-marker" style="min-height: 300px"></div>
