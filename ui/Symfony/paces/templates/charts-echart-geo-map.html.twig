{% extends 'layouts/base.html.twig' %}



{% set title = 'GEO Maps' %}

{% block styles %}

{% endblock %}

{% block content %}
<div class="wrapper">
        {{ include('partials/topbar.html.twig', {"subtitle": "Charts", "title": "GEO Maps"}) }}

        {{ include('partials/sidenav.html.twig') }}

        <!-- Start Page Content here -->
<div class="page-content">
<main>

                {{ include('partials/page-title.html.twig', {"subtitle": "Charts", "title": "GEO Maps"}) }}

                <div class="container-fluid">
<div class="grid xl:grid-cols-2 gap-base">
<div class="card">
<div class="card-header">
<h4 class="card-title">World Map</h4>
</div>
<div class="card-body">
<div id="world-map" style="min-height: 400px"></div>
</div>
</div>
<div class="card">
<div class="card-header">
<h4 class="card-title">USA Map</h4>
</div>
<div class="card-body">
<div id="usa-map" style="min-height: 400px"></div>
</div>
</div>
<div class="card">
<div class="card-header">
<h4 class="card-title">Morphing between Map and Bar Chart</h4>
</div>
<div class="card-body">
<div id="map-bar-morphing" style="min-height: 400px"></div>
</div>
</div>
<div class="card">
<div class="card-header">
<h4 class="card-title">Pie Chart on Geo Map</h4>
</div>
<div class="card-body">
<div id="pie-chart-on-map" style="min-height: 400px"></div>
</div>
</div>
<div class="card">
<div class="card-header">
<h4 class="card-title">GEO SVG Scatter</h4>
</div>
<div class="card-body">
<div id="geo-svg-scatter-map" style="min-height: 400px"></div>
</div>
</div>
</div>
</div>
</main>

            {{ include('partials/footer.html.twig') }}
        </div>
<!-- End Page content -->
</div>

    {{ include('partials/customizer.html.twig') }}

    {{ include('partials/footer-scripts.html.twig') }}

    <!-- E Charts js -->


<!-- E Charts Demo js -->
{% endblock %}

{% block scripts %}
<script src="/plugins/echarts/echarts.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/echarts/map/js/world.js"></script>
    <script src="/js/pages/chart-echart-geo-map.js"></script>
{% endblock %}
