{% extends 'layouts/base.html.twig' %}



{% set title = 'Javascript Source' %}

{% block styles %}

{% endblock %}

{% block content %}
<div class="wrapper">
        {{ include('partials/topbar.html.twig', {"subtitle": "Tables", "title": "Javascript Source"}) }}

        {{ include('partials/sidenav.html.twig') }}

        <!-- Start Page Content here -->
<div class="page-content">
<main>

                {{ include('partials/page-title.html.twig', {"subtitle": "Tables", "title": "Javascript Source"}) }}

                <div class="container-fluid">
<div class="grid grid-cols-1 gap-base">
<div class="card">
<div class="card-header">
