{% extends 'layouts/base.html.twig' %}



{% set title = 'Candlestick Apexchart' %}

{% block styles %}

{% endblock %}

{% block content %}
<div class="wrapper">
        {{ include('partials/topbar.html.twig', {"subtitle": "Charts", "title": "Candlestick Apexchart"}) }}

        {{ include('partials/sidenav.html.twig') }}

        <!-- Start Page Content here -->
<div class="page-content">
<main>

                {{ include('partials/page-title.html.twig', {"subtitle": "Charts", "title": "Candlestick Apexchart"}) }}

                <div class="container-fluid">
<div class="grid grid-cols-1 xl:grid-cols-2 gap-base">
<div class="card">
<div class="card-header">
<h4 class="card-title">Simple Candlestick Charts</h4>
</div>
<div class="card-body">
<div dir="ltr">
<div class="apex-charts" id="simple-candlestick"></div>
</div>
</div>
<!-- end card body-->
</div>
<!-- end card -->
<div class="card">
<div class="card-header">
<h4 class="card-title">Combo Candlestick Charts</h4>
</div>
<div class="card-body">
<div dir="ltr">
<div class="apex-charts" id="combo-candlestick"></div>
<div class="apex-charts" id="combo-bar-candlestick"></div>
</div>
</div>
<!-- end card body-->
</div>
<!-- end card -->
<div class="card">
<div class="card-header">
<h4 class="card-title">Category X-Axis</h4>
</div>
<div class="card-body">
<div dir="ltr">
<div class="apex-charts" id="x-axis-candlestick"></div>
</div>
</div>
<!-- end card body-->
</div>
<!-- end card -->
<div class="card">
<div class="card-header">
<h4 class="card-title">Candlestick with Line</h4>
</div>
<div class="card-body">
<div dir="ltr">
<div class="apex-charts" id="candlestick-with-line"></div>
</div>
</div>
<!-- end card body-->
</div>
<!-- end card -->
</div>
</div>
</main>

            {{ include('partials/footer.html.twig') }}
        </div>
<!-- End Page content -->
</div>

    {{ include('partials/customizer.html.twig') }}

    {{ include('partials/footer-scripts.html.twig') }}

    <!-- Apex Charts js -->

<!-- Apex Chart Candlestick Demo js -->


<!-- Apex Chart Area Demo js -->
{% endblock %}

{% block scripts %}
<script src="/plugins/apexcharts/apexcharts.min.js"></script>
    <script src="https://apexcharts.com/samples/assets/ohlc.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/dayjs/1.8.17/dayjs.min.js"></script>
    <script src="/js/pages/chart-apex-candlestick.js"></script>
{% endblock %}
